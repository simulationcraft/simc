  { 1213910, "Increases Stormstrike and Lava Lash damage by $s1%. This effect is increased to $s2% if using a two-handed weapon.", 0, 0 },
  { 1213915, 0, "Burning.", 0 },
  { 1213918, "Your Stormstrike, Lava Lash and Lava Burst critical strikes cause your target to burn for $s1% of the damage done over $1213915d.", 0, 0 },
  { 1213930, "Damaging a target with Stormstrike, Lava Burst, or Molten Blast also reduces all damage you take by $1213934s1% for $1213934d.", 0, 0 },
  { 1213934, 0, "Reduces all damage taken by $s1%.", 0 },
  { 1213937, "When your Spirit of the Alpha is cast on yourself, it also increases your health by $1213939s1%, your threat generated by $1213939s2%, and all damage you deal by $1213939s3%.", 0, 0 },
  { 1213939, 0, "Increases maximum health by $s1%, threat generated by $s2%, and all damage done by $s3%.", 0 },
  { 1213957, "Your Lava Burst damage is increased by a percentage equal to your spell critical strike chance.", 0, 0 },
  { 1214006, "Increases damage and healing done by magical spells and effects by up to $s1.   Also increases chance to get a critical hit with spells by $s3%.", 0, 0 },
  { 1214085, "Reduces the cooldown on your Chaos Bolt by $s1% and increases Chaos Bolt and Shadow Bolt damage done by $s2%. In addition, Chaos Bolt can now trigger your Improved Shadow Bolt talent and causes it to have $s3 additional charges (does not stack with Shadowflame's additional charges).", 0, 0 },
  { 1214087, "Each time you hit a target with Conflagrate, you gain $1214088s1% increased Fire damage for $1214088d, stacking up to $1214088u times.", 0, 0 },
  { 1214088, 0, "Increases all Fire damage done by $s1%.", 0 },
  { 1214091, "Reduces the cooldown on your Shadow Cleave by ${$m1/-1000}.1 sec.", 0, 0 },
  { 1214095, "The effects of your Demonic Sacrifice now persist while you have a Demon pet active, as long as you do not resummon the sacrificed pet. You may have only one Demonic Sacrifice effect active at a time.", 0, 0 },
  { 1214151, "For $1214156d after using Shadowcleave, your Searing Pain strikes $1214156s1 additional target within melee range.", 0, 0 },
  { 1214155, "Increases the damage dealt by all of your damage over time spells by $s1% per piece of Timeworn armor equipped.", 0, 0 },
  { 1214156, 0, "Your Searing Pain hits $s1 additional targets within melee range.", 0 },
  { 1214159, "Reduces the cooldown on your Death Wish by $s1%.", 0, 0 },
  { 1214160, "Reduces the cooldown on Thunder Clap by $s1%.", 0, 0 },
  { 1214162, "Your Shield Slam deals $s1% increased threat and its cooldown is reset if it is Dodged, Parried, or Blocked.", 0, 0 },
  { 1214163, "You deal $s1% increased damage while any nearby enemy is afflicted with both your Rend and your Deep Wounds.", 0, 0 },
  { 1214165, "Reduces the cooldown on Shockwave by $s1%.", 0, 0 },
  { 1214168, "Coats a weapon with poison that lasts for 30 minutes.\r\nEach strike has a 30% chance of poisoning the enemy for $1214170o1 Nature damage over $1214170d and causing the enemy to take $1214170s2% increased Arcane, Fire, Frost, Nature, and Shadow damage.  Stacks up to $1214170u times on a single target.\r\n\r\nOccult Poison counts as Deadly Poison and benefits from all talents and effects that trigger from or modify Deadly Poison.", 0, "Rank 2" },
  { 1214170, 0, "Target takes $s1 Nature damage every $t1 seconds and $s2% increased Arcane, Fire, Frost, Nature, and Shadow damage.", "Rank 2" },
  { 1214171, "Coats a weapon with poison that lasts for 30 minutes. Each strike has a $h% chance of poisoning the enemy for $1214170o1 Nature damage over $1214170d and causing the enemy to take $1214170s2% increased Arcane, Fire, Frost, Nature, and Shadow damage.  Stacks up to $1214170u times on a single target.\r\n\r\nOccult Poison counts as Deadly Poison and benefits from all talents and effects that trigger from or modify Deadly Poison.\r\n", 0, "Rank 2" },
  { 1215404, "While Metamorphosis or Way of Earth is active, increases the effectiveness of your Fire damage spells by $s1% per piece of Timeworn armor equipped.", 0, 0 },
  { 1216968, "When struck in combat has a $h% chance of inflicting $16782s1 Nature damage to the attacker.", 0, 0 },
  { 1216997, "Reduces all damage taken from players and their pets by $s2%. This effect cannot be combined from multiple sources.", "Reduces all damage taken from players and their pets by $s2%. This effect cannot be combined from multiple sources.", 0 },
  { 1217189, "Permanently enchant bracers to add up to 12 damage to spells.", 0, 0 },
  { 1217203, "Permanently enchant bracers to increase Agility by 9.", 0, 0 },
  { 1217927, 0, "Damage of your next Exorcism is increased by $s1%.", 0 },
  { 1218071, "Summon a songflower that grants all your party or raid members $s1% increased chance for a melee, ranged, or spell critical and $s2 increased attributes for $473399d. Exclusive with similar world effects. Unaffected by Chronoboons.", "Increases chance for a melee, ranged, or spell critical by $s1% and all attributes by $s2.", 0 },
  { 1218121, "Rally your nearby party or raid members, granting them $s1% increased spell critical strike chance, $s3% increased melee and ranged critical strike chance, and $s2 increased attack power. Lasts $473387d. Exclusive with similar world effects and unaffected by Chronoboons.", "Increases critical chance of spells by $s1%, melee and ranged by $s3% and grants $s2 attack power.", 0 },
  { 1218154, 0, "Sinister Strike hits $s1 additional nearby target.", 0 },
  { 1218240, "You attempt to finish off a wounded target, firing a ranged attack dealing $s2% weapon damage plus ${$m1/100*$m2/100*$<damagepower>}. Kill Shot has no minimum range. Kill Shot's cooldown is reset if used on an enemy that has 20% or less health.", 0, 0 },
  { 1218345, 0, "Target takes $s1% increased damage from the caster's next Ice Lance.", 0 },
  { 1218352, "Gives your Frost damage spells a $h% chance to apply the Winter's Chill effect, which increases the chance a Frost spell will critically hit the target by $12579s1% for $12579d.  Stacks up to $12579u times.", 0, 0 },
  { 1218358, "Send the target into a rabid frenzy, increasing melee attack power by $s1 but reducing armor by $s2 for $d.  Rabid enemies will not flee and will ignore Fear and Horror effects.", "Increases melee attack power by $s1 and decreases armor by $s2.   Target will not flee and will ignore Fear and Horror effects.", 0 },
  { 1219090, "Silence the target for $d.", "Silenced.", 0 },
  { 1219093, "Seize a thread of the enemy's soul to tug their physical form toward you. May not be used on enemies higher than level ${$PL+1} or which are marked as boss enemies.", 0, 0 },
  { 1219110, "$@spelldesc1219093", 0, 0 },
  { 1219111, "$@spelldesc1219093", 0, 0 },
  { 1219121, "Inflict Blood Plague upon the enemy target which deals $M1 Shadow damage every $t1 sec for $d.", "Suffering $w1 Shadow damage every $t1 sec.", 0 },
  { 1219124, "Inflict Frost Fever upon the enemy target which deals $M1 Frost damage every $t1 sec for $d.", "Suffering $w1 Frost damage every $t1 sec.", 0 },
  { 1219153, "Mark an enemy. Whenever they deal damage, the target is healed for $M1% of their maximum health. Lasts $d or up to $U hits.\r\n\r\nStacks are not depleted on Undead targets. Only one Mark of Blood can be active on a target at a time.", "Hits from this target restore $m~1% health.", 0 },
  { 1219161, "$@spelldesc1219153", 0, 0 },
  { 1219176, "Obliterate your target, dealing $M1 damage.\r\n\r\nAn infection of Blood Plague or Frost Fever on your target each increase the damage dealt by $M2%.", 0, 0 },
  { 1219178, "$@spelldesc1219176", 0, 0 },
  { 1219274, "Learn a Priest spell from another race to activate an ability in this slot.", 0, 0 },
  { 1219539, "Unlocks your potential while inside Naxxramas.  Increasing your damage by ${$m1/100}.2% and your health by ${$m2/100}.2% for each Sanctified item equipped.  (Equipping more than $1223336s2 Sanctified items provides no additional benefit)", "Unlocks your potential while inside Naxxramas.  Increasing your damage by ${$m1/100}.2% and your health by ${$m2/100}.2% for each Sanctified item equipped.", 0 },
  { 1219548, "Unlocks your potential while inside Naxxramas.  Increasing your healing by ${$m1/100}.2% and your health by ${$m2/100}.2% for each Sanctified item equipped.  (Equipping more than $1223336s2 Sanctified items provides no additional benefit)", "Unlocks your potential while inside Naxxramas.  Increasing your healing by ${$m1/100/$u}.2% and your health by ${$m2/100/$u}.2% for each Sanctified item equipped.", 0 },
